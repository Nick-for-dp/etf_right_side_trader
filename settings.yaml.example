  - akshare_symbol: sh000001
    baostock_code: sh.000001
    code: '000001'
    name: 上证指数
    source: baostock
    weight: 1.5
  - akshare_symbol: sh000300
    baostock_code: sh.000300
    code: '000300'
    name: 沪深300
    source: baostock
    weight: 1.5
  - akshare_symbol: sh000905
    baostock_code: sh.000905
    code: 000905
    name: 中证500
    source: baostock
    weight: 1.0
  - akshare_symbol: sh000852
    baostock_code: sh.000852
    code: 000852
    name: 中证1000
    source: baostock
    weight: 1.0
  - akshare_symbol: sz399006
    baostock_code: sz.399006
    code: '399006'
    name: 创业板指
    source: baostock
    weight: 1.0
  - akshare_symbol: sh000688
    baostock_code: sh.000688
    code: 000688
    name: 科创50
    source: akshare
    weight: 1.0
  - akshare_symbol: .NDX
    code: NDX
    name: 纳指100
    source: akshare_us
    weight: 0.0
  - akshare_symbol: HSTECH
    code: HZ5017
    name: 恒生科技指数
    source: tushare_global
    tushare_code: HKTECH
    weight: 0.0
  regime:
    cold_ratio: 0.6
    cold_score: -0.55
    enabled: true
    hot_ratio: 0.6
    hot_score: 0.55
    lookback_days: 180
    min_indices: 4
account:
  capital: 100000
  max_position_ratio: 0.3
risk_control:
  rules:
  - params:
      days: 90
    type: max_holding_days
  - params:
      default_profile: fixed_8
    type: profile_stop_loss
scheduler:
  run_time: 07:00
  timezone: Asia/Shanghai
strategy:
  params:
    cooldown_days: 5
    entry_add_budget:
      add_steps:
      - min_score: 60
        ratio: 0.15
        require_profit: true
      - min_score: 70
        ratio: 0.15
        require_profit: true
      entry_ratio: 0.7
    entry_budget_overrides:
      high_vol:
        enabled: true
        kind: quality_tier
        medium_multiplier: 0.8
        medium_score: 55
        strong_multiplier: 1.0
        strong_score: 65
        weak_multiplier: 0.6
    ma_long: 60
    ma_short: 20
    thresholds:
      buy: 50
      sell: -50
    volatility_signal_profiles:
      high_vol:
        enabled: true
        kind: high_vol_balanced
      low_vol:
        enabled: false
    weights:
      bb: 0.25
      macd: 0.25
      rsi: 0.15
      trend: 0.35
  type: multi_indicator_scoring
